DESCRIPTION Concept/RAG band, virtualization concepts (Proxmox LXC vs KVM, when to choose each); coordinator-answerable, no fabrication.

DEFINE CONST QUESTION AS "What are the key differences between Proxmox LXC containers and KVM
  virtual machines, and when would you choose each?"
DEFINE CONST MAX_DURATION AS 300 seconds

ASSERT(POST to discussion endpoint returns 200 with conversationId)
ASSERT(SSE stream emits "thread_found" event within 30 seconds)
ASSERT(discussion completes with "done" event within MAX_DURATION)

# Concept questions are coordinator-answerable; specialists correctly stand
# aside when no tool call is needed. Assert synthesis quality, not specialist
# participation.
ASSERT(coordinator produces synthesis)
ASSERT(synthesis is non-empty)

# RAG quality, both concepts must appear in the synthesis
ASSERT(synthesis CONTAINS "LXC" AND "KVM")

# Reference-grounded quality, deferred LLM judge (FitnessCrew) scores the
# synthesis 0.0-1.0 against this ground truth from cluster-ground-truth-baseline.md.
ASSERT(DEFER synthesis REFLECTS "Explains Proxmox LXC containers (OS-level, shared host kernel, lightweight, high density, Linux guests, lower isolation) versus KVM virtual machines (full virtualization, own kernel, any OS, stronger isolation, snapshots/live-migration/PCIe passthrough, more overhead), and when to choose each. Accurate, no fabrication.")
